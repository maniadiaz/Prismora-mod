{
  "formatVersion": 1,
  "name": "Prismora Bloom",
  "version": "1.0.0",
  "dynamicUniforms": true,
  "passes": [
    {
      "name": "bright",
      "vertex": "shaders/post.vsh",
      "fragment": "shaders/bright.fsh",
      "inputs": {
        "SceneColor": "sceneColor"
      },
      "output": "bright",
      "feature": "bloom",
      "bypass": "SceneColor",
      "scale": 0.5
    },
    {
      "name": "horizontal",
      "vertex": "shaders/post.vsh",
      "fragment": "shaders/blur_x.fsh",
      "inputs": {
        "SceneColor": "bright"
      },
      "output": "blur",
      "feature": "bloom",
      "bypass": "SceneColor",
      "scale": 0.5
    },
    {
      "name": "vertical",
      "vertex": "shaders/post.vsh",
      "fragment": "shaders/blur_y.fsh",
      "inputs": {
        "SceneColor": "blur"
      },
      "output": "glow",
      "feature": "bloom",
      "bypass": "SceneColor",
      "scale": 0.5
    },
    {
      "name": "composite",
      "vertex": "shaders/post.vsh",
      "fragment": "shaders/composite.fsh",
      "inputs": {
        "SceneColor": "sceneColor",
        "Bloom": "glow"
      },
      "output": "screen",
      "uniforms": {
        "BloomOptions": [
          {
            "type": "float",
            "value": 0.35
          }
        ]
      },
      "feature": "bloom",
      "bypass": "SceneColor"
    }
  ],
  "options": {
    "bloom_strength": {
      "label": "Bloom strength",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.35,
      "pass": "composite",
      "block": "BloomOptions",
      "index": 0
    }
  }
}